@using CvGen.Components.CvKeywords

<MudText Typo="Typo.subtitle2">
    @Model.DatesRangeToString
</MudText>
<MudCard Outlined="false" Elevation="5">
    <MudCardContent>
        <MudText Color="Color.Primary"
                 Typo="Typo.h5">
            @Model.Company - @Model.Position
        </MudText>
        <hr/>
        <MudText Align="Align.Justify" Class="mb-2">
            @Model.Description
        </MudText>
        @if (Model.AllKeywords.Length > 0)
        {
            <MudCollapse Expanded=@(!Open)>
                <CvKeywords Keywords="@Model.AllKeywords" />
            </MudCollapse>
        }
        @if (Model.Projects.Length > 0)
        {
            <hr/>
            <MudBadge Content="@Model.Projects.Length"
                      Color="Color.Secondary"
                      Overlap="true"
                      Visible="@(!Open)"
                      Bordered="true">
                <MudButton Color="Color.Primary"
                           Variant="Variant.Outlined"
                           Size="Size.Small"
                           StartIcon="@(Open ? Icons.Material.Filled.ArrowCircleUp : Icons.Material.Filled.ArrowCircleDown)"
                           Style="width: 175px; justify-content:flex-start;"
                           OnClick="@(() => Open = !Open)">
                    @(Open ? "Hide projects" : $"Show projects")
                </MudButton>
            </MudBadge>
            <MudCollapse Expanded="Open">
                @foreach (var project in Model.Projects)
                {
                    <MudSimpleTable Elevation="0"
                                    Bordered="true"
                                    Class="mt-6"
                                    Style="overflow-x: auto;">
                        <tbody>
                        <tr>
                            <td style="text-align: right;">
                                <b>Name:</b>
                            </td>
                            <td>
                                @project.Name
                            </td>
                        </tr>
                        <tr>
                            <td style="text-align: right;">
                                <b>Description:</b>
                            </td>
                            <td>
                                @project.Description
                            </td>
                        </tr>
                        <tr>
                            <td style="text-align: right;">
                                <b>Keywords:</b>
                            </td>
                            <td>
                                @if (project.Keywords.Length > 0)
                                {
                                    <CvKeywords Keywords="@project.Keywords" />
                                }
                            </td>
                        </tr>
                        </tbody>
                    </MudSimpleTable>
                }
            </MudCollapse>
        }
    </MudCardContent>
</MudCard>
